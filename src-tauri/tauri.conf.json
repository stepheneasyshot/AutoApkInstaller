{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoApkInstaller",
  "version": "1.0.3",
  "identifier": "com.mac.autoapkinstaller",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoApkInstaller",
        "width": 480,
        "height": 360,
        "minWidth": 400,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "fileAssociations": [
      {
        "ext": ["apk"],
        "name": "Android APK",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.android.package-archive",
        "exportedType": {
          "identifier": "com.mac.autoapkinstaller.apk",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
