{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoApkInstaller",
  "version": "1.0.1",
  "identifier": "com.mac.autoapkinstaller",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoApkInstaller",
        "width": 800,
        "height": 680,
        "minWidth": 460,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "resources/platform-tools/adb": "platform-tools/adb",
      "resources/platform-tools/NOTICE.txt": "platform-tools/NOTICE.txt",
      "resources/platform-tools/source.properties": "platform-tools/source.properties"
    },
    "fileAssociations": [
      {
        "ext": ["apk"],
        "name": "Android APK",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.android.package-archive",
        "exportedType": {
          "identifier": "com.mac.autoapkinstaller.apk",
          "conformsTo": ["public.data"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
